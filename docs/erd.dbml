Enum user_status {
  ACTIVE
  BANNED
}

Table Room {
  id integer [primary key, increment]
  name varchar(10) [not null]
  open_at time [not null]
  close_at time [not null]
  weekday_open boolean [not null]
  weekend_open boolean [not null]

  Note: '평일·주말 운영 여부와 반복 운영 시간. 자정을 넘는 구간을 허용하며 열림 여부는 Spring에서 판단한다.'
}

Table AnonymousUser {
  id integer [primary key, increment]
  nickname varchar(30) [not null]
  created_at date [not null]
  last_seen_at timestamp [not null]
  status user_status [not null, default: 'ACTIVE']
  token_hash varchar(64) [not null]
  banned_until timestamp [null]

  indexes {
    (token_hash) [unique]
  }
}

Table Report {
  id integer [primary key, increment]
  message_event_id uuid [not null]
  reporter_user_id integer [not null, ref: > AnonymousUser.id]
  reported_user_id integer [not null, ref: > AnonymousUser.id]
  room_id integer [not null, ref: > Room.id]
  reason varchar(500) [not null]
  evidence_content varchar(140) [not null]
  message_sent_at timestamp [not null]
  created_at timestamp [not null]
  evidence_expires_at timestamp [not null]

  indexes {
    (reporter_user_id, message_event_id) [unique]
    (evidence_expires_at)
    (reported_user_id)
  }

  Note: '신고 대상은 사용자. 서버 메모리 원본에서 복사한 메시지만 증거로 저장한다. 일반 Message 테이블은 없다.'
}

Table Game {
  id Integer [primary key]
  name text [not null]
  created_at timestamp [not null]
  active boolean [not null]
}

Table GamePlay {
  id Integer [primary key]
  anonymous_user_id Integer [ref: > AnonymousUser.id, not null]
  game_id Integer [ref: > Game.id, not null]
  score Integer [not null]
  played_at timestamp [not null]
}
