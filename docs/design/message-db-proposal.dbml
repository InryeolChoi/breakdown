// Q1~Q7 합의 후 검토 기록. 최신 목표 ERD는 docs/erd.dbml을 따른다.
// 실제 DB/Java 전환 완료(2026-10-06). 검토 과정은 message-db-proposal.md 참고.
Enum user_status {
  ACTIVE
  BANNED
}

Table Room {
  id integer [primary key, increment]
  name varchar(10) [not null]
  open_at time [not null]
  close_at time [not null]
  weekday_open boolean [not null]
  weekend_open boolean [not null]

  Note: '평일·주말 운영 여부와 반복 운영 시간. 자정을 넘는 구간을 허용하며 열림 여부는 Spring에서 판단한다.'
}

Table AnonymousUser {
  id integer [primary key, increment]
  nickname varchar(30) [not null]
  created_at date [not null]
  last_seen_at timestamp [not null]
  status user_status [not null, default: 'ACTIVE']
  token_hash varchar(64) [not null]
  banned_until timestamp [null]

  indexes {
    (token_hash) [unique]
  }
}

Table Message {
  id uuid [primary key, not null, note: '서버가 생성하는 메시지 UUID. 기존 API messageId와 동일한 역할.']
  room_id integer [not null, ref: > Room.id]
  anonymous_user_id integer [not null, ref: > AnonymousUser.id]
  nickname varchar(30) [not null, note: '작성 당시 닉네임 복사. 현재 ChatMessage 응답 의미 유지.']
  content varchar(140) [not null]
  sent_at timestamp [not null, note: '현재 프로젝트와 동일한 서울 기준 LocalDateTime.']
  expires_at timestamp [not null, note: '신고 가능 기한: 작성 후 15분과 해당 운영 구간 종료 중 빠른 시각.']
  delete_after timestamp [not null, note: '해당 방 운영 구간 종료 + 10분. 실제 삭제의 기준 시각.']

  indexes {
    (delete_after)
  }

  Note: '합의한 DB 임시 보관 설계. 신고 가능 기한과 실제 삭제 기한을 분리하고 삭제 대상은 1분 간격 정리. 과거 대화 목록 API 없음. 시간 CHECK와 공백 검증은 V10에서 구현.'
}

Table Report {
  id integer [primary key, increment]
  message_event_id uuid [not null, note: '원본 Message.id를 복사한 추적 식별자. 의도적으로 Message 외래 키를 걸지 않음.']
  reporter_user_id integer [not null, ref: > AnonymousUser.id]
  reported_user_id integer [not null, ref: > AnonymousUser.id]
  room_id integer [not null, ref: > Room.id]
  reason varchar(500) [not null]
  evidence_content varchar(140) [not null]
  message_sent_at timestamp [not null]
  created_at timestamp [not null]
  evidence_expires_at timestamp [not null]

  indexes {
    (reporter_user_id, message_event_id) [unique]
    (evidence_expires_at)
    (reported_user_id)
  }

  Note: '신고 대상은 사용자. 유효한 DB Message 원본을 복사해 증거를 30일 보관하는 제안. 원본 삭제와 독립된 증거이며 기존 V9 스키마 유지.'
}

Table Game {
  id Integer [primary key]
  name text [not null]
  created_at timestamp [not null]
  active boolean [not null]
}

Table GamePlay {
  id Integer [primary key]
  anonymous_user_id Integer [ref: > AnonymousUser.id, not null]
  game_id Integer [ref: > Game.id, not null]
  score Integer [not null]
  played_at timestamp [not null]
}
